# Copy this file to .env (same folder as docker-compose.yml) and adjust the values.

# --- PostgreSQL ---
POSTGRES_DB=manga_whisper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- API: JWT ---
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ISSUER=MangaWhisperApi
JWT_AUDIENCE=MangaWhisperApp

# --- API: admin user (created on API startup if it doesn't exist) ---
# Password rules: 8+ chars, upper, lower, digit and symbol
ADMIN_EMAIL=admin@mangawhisper.local
ADMIN_PASSWORD=Admin123!

# The background worker has no schedule settings: scraping jobs are created in the admin panel
# (Control panel > Scheduled jobs) and stored in the database.
