# Copy this file to .env (same folder as docker-compose.yml) and adjust the values.

# --- PostgreSQL ---
POSTGRES_DB=manga_whisper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- API: JWT ---
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ISSUER=MangaWhisperApi
JWT_AUDIENCE=MangaWhisperApp

# --- API: admin user (created on API startup if it doesn't exist) ---
# Password rules: 8+ chars, upper, lower, digit and symbol
ADMIN_EMAIL=admin@mangawhisper.local
ADMIN_PASSWORD=Admin123!

# --- Background worker schedule (times in BRT) ---
# Days of week: 0=Sunday ... 6=Saturday, comma-separated
CHECK_DAYS_OF_WEEK=4,5
CHECK_START_HOUR=12
CHECK_INTERVAL_HOURS=4

# One-off backfill: walks every chapter from LastKnownChapter+1 until one is missing
ENABLE_BATCH_SCRAPING=false
STOP_APP_AFTER_BATCH_SCRAPING=false
