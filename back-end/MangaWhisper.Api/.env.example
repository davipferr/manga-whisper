# Only needed to run the API outside Docker (e.g. debugging with `dotnet run`).
# Copy this file to .env. With Docker, the values come from the .env next to docker-compose.yml instead.

# Database Connection (values match the Docker PostgreSQL from ../../.env.example)
DefaultConnection=Host=localhost;Database=manga_whisper;Username=postgres;Password=postgres;Port=5432

# JWT Configuration
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ISSUER=MangaWhisperApi
JWT_AUDIENCE=MangaWhisperApp

# Admin User Configuration
ADMIN_EMAIL=admin@mangawhisper.local
ADMIN_PASSWORD=Admin123!
